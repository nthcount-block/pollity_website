<div class="mapdoughnut">
    <div class="">
        <div class="container">
            <div class="stats">
                <div>

                    <h1 >Votes by Region</h1>
                    <p>Total Votes </p>
                    <h1 class="voteCount">5 </h1>
                </div>
                <div class="">
                    <p><span class="dot red"></span> PDP: <span id="pdp-votes">2</span></p>
                    <p><span class="dot blue"></span> APC: <span id="apc-votes">2</span></p>
                    <p><span class="dot green"></span> LP: <span id="lp-votes">1</span></p>
                </div>
            </div>
           


        <div class="map-container">
            <!-- Include the SVG -->
            <object id="nigeria-map" data="images/nigeria.svg" type="image/svg+xml"></object>
        </div>
        </div>
    </div>


    <!-- doughnut -->

    <div class="chart-container2">
        <h2>Election progress</h2>
        <div class="legend2">
            <span><span class="dot2 gray"></span> Not started <br> <b>1,000,032</b></span>
            <span><span class="dot2 blue"></span> In progress <br> <b>2,000,032</b></span>
            <span><span class="dot2 green"></span> Completed <b>00,032</b></span>
        </div>
        <canvas id="electionChart2"></canvas>
    </div>
</div>

<!-- pie -->
<div class="chart-container3">
    <!-- Voter Turnout by Gender -->
    <div class="chart-box-custom">
        <div>

            <h3>Voter turnout by gender</h3>
            <div class="legend-custom">
                <span><span class="dot-custom green-dark"></span> Male</span>
                <span><span class="dot-custom green-light"></span> Female</span>
            </div>
        </div>
        <canvas id="genderChart"></canvas>
    </div>

    <!-- Voter Turnout by Age -->
    <div class="chart-box-custom">
        <div>

            <h3>Voter turnout by age</h3>
            <div class="legend-custom " id="age">
                <span><span class="dot-custom green-1"></span> 18-30</span>
                <span><span class="dot-custom green-2"></span> 31-40</span>
                <span><span class="dot-custom green-3"></span> 41-50</span>
                <span><span class="dot-custom green-4"></span> 51-60</span>
                <span><span class="dot-custom green-5"></span> 61-70</span>
                <span><span class="dot-custom green-6"></span> >70</span>
            </div>
        </div>
        <canvas id="ageChart"></canvas>
    </div>
</div>

<!-- table -->
 <div class="theader">


<header class="header">
    <div class="header__info">
        <span class="header__item">States <strong class="header__badge">1</strong></span>
        <span class="header__item">Local Govts <strong class="header__badge">20</strong></span>
        <span class="header__item">Polling Units <strong class="header__badge">5000</strong></span>
    </div>
    <input type="text" id="searchInput" class="header__search" placeholder="Search">
</header>

<!-- LEADERBOARD SECTION -->
<section class="leaderboard" id="leaderboard">    
</section>
</div>
<!-- TABLE SECTION -->
<table id="electionTable" class="table">
    <thead class="table__head">
        <tr>
            <th class="table__header" onclick="sortTable(0)" colspan="2">State</th>
            <th class="table__header" onclick="sortTable(1)">Status</th>
            <th class="table__header" onclick="sortTable(2)">Leading Party</th>
            <th class="table__header" onclick="sortTable(3)">Total Registered Voters</th>
            <th class="table__header" onclick="sortTable(4)">Votes Cast</th>
        </tr>
    </thead>
    <tbody class="table__body" id="tableBody">
        <tr class="table__row">
            <td class="table__data" colspan="2">Lagos</td>
            <td class="table__data"><span class="status status--completed">Completed</span></td>
